

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Период.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	Период.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура СформироватьРеестр(Команда)
	СформироватьРеестрНаСервере();
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗапросВыборкаФактур()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Период.ДатаОкончания));
	#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ФактураТранзакции.Клиент КАК Клиент,
		|	ФактураТранзакции.ЭтапОплаты КАК ЭтапОплаты,
		|	ФактураТранзакции.Валюта КАК Валюта,
		|	СУММА(ФактураТранзакции.Количество) КАК Количество,
		|	СУММА(ФактураТранзакции.Итого) КАК Итого,
		|	ФактураТранзакции.Ссылка КАК ФактураСсылка,
		|	ФактураТранзакции.Ссылка.Дата КАК ДатаФактуры
		|ПОМЕСТИТЬ ВТ_ДанныеТранзакций
		|ИЗ
		|	Документ.Фактура.Транзакции КАК ФактураТранзакции
		|ГДЕ
		|	ФактураТранзакции.Ссылка.Проведен
		|	И ФактураТранзакции.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ФактураТранзакции.Клиент,
		|	ФактураТранзакции.Валюта,
		|	ФактураТранзакции.ЭтапОплаты,
		|	ФактураТранзакции.Ссылка,
		|	ФактураТранзакции.Ссылка.Дата
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Клиент,
		|	ФактураСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеТранзакций.Клиент КАК Клиент,
		|	ВТ_ДанныеТранзакций.ЭтапОплаты КАК ЭтапОплаты,
		|	ВТ_ДанныеТранзакций.Валюта КАК Валюта,
		|	ВТ_ДанныеТранзакций.Количество КАК Количество,
		|	ОКР(ВТ_ДанныеТранзакций.Итого, 0) КАК Итого,
		|	ВТ_ДанныеТранзакций.ФактураСсылка КАК ФактураСсылка,
		|	ВТ_ДанныеТранзакций.ДатаФактуры КАК ДатаФактуры,
		|	ЕСТЬNULL(НомераФактур.НомерФактуры, 0) КАК НомерФактуры
		|ИЗ
		|	ВТ_ДанныеТранзакций КАК ВТ_ДанныеТранзакций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераФактур КАК НомераФактур
		|		ПО ВТ_ДанныеТранзакций.ФактураСсылка = НомераФактур.Фактура
		|			И ВТ_ДанныеТранзакций.Клиент = НомераФактур.Контрагент
		|
		|УПОРЯДОЧИТЬ ПО
		|	Валюта,
		|	ВТ_ДанныеТранзакций.Клиент.Наименование,
		|	ЭтапОплаты
		|ИТОГИ
		|	СУММА(Количество),
		|	СУММА(Итого)
		|ПО
		|	Валюта";
	#КонецОбласти	
	Возврат Запрос;	
КонецФункции	

&НаСервере
Процедура СформироватьРеестрНаСервере()
	ТабличныйДокумент.Очистить();
	
	Макет = Обработки.РеестрФактур.ПолучитьМакет("РеестрФактур");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок"); 
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьВалюта = Макет.ПолучитьОбласть("Валюта");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");	
		
		
	ОбластьШапка.Параметры.ДатаНач = Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy;");
	ОбластьШапка.Параметры.ДатаКон = Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy;");
	
	Запрос = ЗапросВыборкаФактур();
	
	//@skip-check new-color
	ЦветФона = Новый Цвет(160, 224, 224);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ОбластьОформления = ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
	ТабличныйДокумент.Область(ОбластьОформления.Верх, 2, ОбластьОформления.Низ, ТабличныйДокумент.ШиринаТаблицы).ЦветФона = ЦветФона;				
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВалюты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Валюта");
	ИтогКоличество = 0;
	Счетчик = 0;

	Пока ВыборкаВалюты.Следующий() Цикл
		ВыборкаДетальныеЗаписи = ВыборкаВалюты.Выбрать();
		
		ИтогКоличество = ИтогКоличество + ВыборкаВалюты.Количество;
		ЗаполнитьЗначенияСвойств(ОбластьВалюта.Параметры, ВыборкаВалюты);
		ОбластьОформления = ТабличныйДокумент.Вывести(ОбластьВалюта);
		ТабличныйДокумент.Область(
				ОбластьОформления.Верх, 2, ОбластьОформления.Низ, ТабличныйДокумент.ШиринаТаблицы).ЦветФона = ЦветФона;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Счетчик = Счетчик + 1;
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаДетальныеЗаписи);
			ОбластьОформления = ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			Если Счетчик % 2 = 0 Тогда
				ТабличныйДокумент.Область(
						ОбластьОформления.Верх, 2, ОбластьОформления.Низ, ТабличныйДокумент.ШиринаТаблицы).ЦветФона = ЦветФона;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	ОбластьИтог.Параметры.ИтогКоличество = ИтогКоличество;
	ОбластьИтог.Параметры.ИтогИтог = "";
		
	ОбластьОформления = ТабличныйДокумент.Вывести(ОбластьИтог);
	Если Счетчик % 2 = 0 Тогда
		ТабличныйДокумент.Область(
				ОбластьОформления.Верх, 2, ОбластьОформления.Низ, ТабличныйДокумент.ШиринаТаблицы).ЦветФона = ЦветФона;
	КонецЕсли;	
	
	ТабличныйДокумент.ФиксацияСверху = 10;
	ТабличныйДокумент.АвтоМасштаб = Истина;	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьРеестрНаСайтНаСервере()
	Запрос = ЗапросВыборкаФактур();
	
	ТаблицаФактур = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаФактур", ТаблицаФактур);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаФактур.Клиент КАК Клиент,
	               |	ТаблицаФактур.ЭтапОплаты КАК ЭтапОплаты,
	               |	ТаблицаФактур.Валюта КАК Валюта,
	               |	ТаблицаФактур.Количество КАК Количество,
	               |	ТаблицаФактур.Итого КАК Итого,
	               |	ТаблицаФактур.ДатаФактуры КАК ДатаФактуры,
	               |	ТаблицаФактур.НомерФактуры КАК НомерФактуры
	               |ПОМЕСТИТЬ ВТ_ТаблицаФактур
	               |ИЗ
	               |	&ТаблицаФактур КАК ТаблицаФактур
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТаблицаФактур.Клиент КАК Клиент,
	               |	ВТ_ТаблицаФактур.ЭтапОплаты КАК ЭтапОплаты,
	               |	ВТ_ТаблицаФактур.Валюта КАК Валюта,
	               |	ВТ_ТаблицаФактур.Количество КАК Количество,
	               |	ВТ_ТаблицаФактур.Итого КАК Итого,
	               |	ВТ_ТаблицаФактур.ДатаФактуры КАК ДатаФактуры,
	               |	ВТ_ТаблицаФактур.НомерФактуры КАК НомерФактуры,
	               |	Контрагенты.Логин КАК Логин
	               |ИЗ
	               |	ВТ_ТаблицаФактур КАК ВТ_ТаблицаФактур
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО ВТ_ТаблицаФактур.Клиент = Контрагенты.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Клиент,
	               |	ДатаФактуры
	               |ИТОГИ
	               |	МАКСИМУМ(Логин)
	               |ПО
	               |	Клиент";
	
	ВыборкаКлиент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Клиент");
	Счетчик = 0;
	Пока ВыборкаКлиент.Следующий() Цикл
		ТаблицаКлиента = ТаблицаКлиентаШаблон();
		ВыборкаЗаписи = ВыборкаКлиент.Выбрать();
		Пока ВыборкаЗаписи.Следующий() Цикл
			НоваяСтрока = ТаблицаКлиента.Добавить();
			НоваяСтрока.Date = Формат(ВыборкаЗаписи.ДатаФактуры, "ДФ=dd.MM.yy");
			НоваяСтрока.Number = Формат(ВыборкаЗаписи.НомерФактуры, "ЧГ=0");
			НоваяСтрока.Valuta = ВыборкаЗаписи.Валюта;
			НоваяСтрока.Litry = Формат(ВыборкаЗаписи.Количество, "ЧГ=0");;
			НоваяСтрока.Summa = Формат(ВыборкаЗаписи.Итого, "ЧГ=0");;
			НоваяСтрока.FileName = НоваяСтрока.Number
		КонецЦикла;
		Попытка
			ИмяФайлаВыгрузки = Exprovip.СформироватьИмяФайла(ВыборкаКлиент.Логин, "invoice\invoicelist", "csv");
			Exprovip.ВыгрузитьТаблицуВCSV(ТаблицаКлиента, ";", ИмяФайлаВыгрузки);
			
			Счетчик = Счетчик + 1;
		Исключение
			Сообщение = СтрШаблон("Ошибка выгрузки %1. Ошибка: %2", ВыборкаКлиент.Клиент, ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
		КонецПопытки;
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		Сообщение = СтрШаблон("Выгружено успешно: %1 клиентов", Счетчик);
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	КонецЕсли;
КонецПроцедуры

Функция ТаблицаКлиентаШаблон()
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Date");
	ТаблицаЗначений.Колонки.Добавить("Number");
	ТаблицаЗначений.Колонки.Добавить("Valuta");
	ТаблицаЗначений.Колонки.Добавить("Litry");
	ТаблицаЗначений.Колонки.Добавить("Summa");
	ТаблицаЗначений.Колонки.Добавить("FileName");
	
	Возврат ТаблицаЗначений;
КонецФункции	

&НаКлиенте
Процедура ВыгрузитьРеестрНаСайт(Команда)
	ВыгрузитьРеестрНаСайтНаСервере();
КонецПроцедуры
#КонецОбласти

