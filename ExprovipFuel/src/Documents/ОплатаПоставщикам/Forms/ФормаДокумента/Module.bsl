&НаКлиенте
Процедура ОплатыСуммаВалютнаяПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Оплаты.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	ОплатыСуммаВалютнаяПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
КонецПроцедуры

&НаСервере
Процедура ПересчетСтрокиОтСуммы(СтрокаТаблицы)
	Если СтрокаТаблицы.Курс = 0 Тогда
		Возврат;
	КонецЕсли;	
	СтрокаТаблицы.СуммаВалютная = СтрокаТаблицы.Сумма / СтрокаТаблицы.Курс;
КонецПроцедуры

&НаСервере
Процедура ПересчетСтрокиОтВалютнойСуммы(СтрокаТаблицы)
	Если СтрокаТаблицы.Курс = 0 Тогда
		Возврат;
	КонецЕсли;	
	СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВалютная * СтрокаТаблицы.Курс;
КонецПроцедуры

&НаСервере
Функция ПолучитьКурсПересчета(ВалютаСсылка)
	Курс = 1;
	ВалютаЕвро = Справочники.Валюты.НайтиПоКоду("978");
	Если ВалютаСсылка.Код = "933" Тогда //Бел рубль
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Валюта", ВалютаСсылка);
		Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(Объект.Дата));
		Запрос.Текст = "ВЫБРАТЬ
		               |	КурсыВалютСрезПоследних.КурсВзаиморасчетов КАК КурсВзаиморасчетов
		               |ИЗ
		               |	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаЗапроса, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Курс = Выборка.КурсВзаиморасчетов;
		КонецЕсли;		
	ИначеЕсли  ВалютаСсылка.Код = "643" Тогда //Российский рубль
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Валюта", ВалютаЕвро);
		Запрос.УстановитьПараметр("ДатаЗапроса", КонецДня(Объект.Дата));
		Запрос.Текст = "ВЫБРАТЬ
		               |	КурсыВалютСрезПоследних.КурсВзаиморасчетов КАК КурсВзаиморасчетов
		               |ИЗ
		               |	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаЗапроса, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Курс = Выборка.КурсВзаиморасчетов;
		КонецЕсли;
	ИначеЕсли ВалютаСсылка = ВалютаЕвро Тогда		
		Курс = 1;
	КонецЕсли;
	Возврат Курс;	
КонецФункции	               

