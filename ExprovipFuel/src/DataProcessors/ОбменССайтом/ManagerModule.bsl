	ТаблицаДанные.Колонки.Добавить("Автомобиль", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТаблицаДанные.Колонки.Добавить("МестоТранзакции", Новый ОписаниеТипов("СправочникСсылка.МестаТранзакции"));
	ТаблицаДанные.Колонки.Добавить("Продукт", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДанные.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
