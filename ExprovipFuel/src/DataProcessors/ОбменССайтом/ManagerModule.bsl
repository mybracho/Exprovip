	Структура.Вставить("Date", "");
	Структура.Вставить("Number", "");
	Структура.Вставить("Currency", "");
	Структура.Вставить("Amount", "");
	Структура.Вставить("Metadata", "");
	
	Возврат Структура;
КонецФункции

