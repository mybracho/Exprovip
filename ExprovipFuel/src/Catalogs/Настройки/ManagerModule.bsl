#Область ПрограммныйИнтерфейс

// Получить настройки.
// 
// Возвращаемое значение:
//  Структура - Получить настройки:
// * EUR - СправочникСсылка.Валюты - 
// * USD - СправочникСсылка.Валюты - 
// * RUB - СправочникСсылка.Валюты - 
// * BYN - СправочникСсылка.Валюты - 
// * ПутьДляВыгрузки - Строка - 
// * ПутьДляВыгрузкиИнвойсов - Строка - 
// * ПутьДляКопийФактур - Строка - 
// * ПутьВыгрузкиДляСайта - Строка - 
// * APIСайтДляВыгрузкиДанных - Строка -
// * APIРесурсВыгрузкиКлиентов - Строка -
// * APIРесурсВыгрузкиОплат - Строка -
// * APIРесурсВыгрузкиФактуры - Строка -
// * APIРесурсВыгрузкиБаланса - Строка -
// * APIРесурсУдалениеДанных - Строка -
// * APIРесурсУдалениеКарточек - Строка -
// * APIРесурсВыгрузкиТранзакций - Строка
// * APIРесурсВыгрузкиПаролей - Строка
// * APIKey - Строка -
// * ПарольАрхиваПриОбмене - Строка -
Функция ПолучитьНастройки() Экспорт
	Структура = Новый Структура;
	Структура.Вставить("EUR", Справочники.Валюты.ПустаяСсылка());
	Структура.Вставить("USD", Справочники.Валюты.ПустаяСсылка());
	Структура.Вставить("RUB", Справочники.Валюты.ПустаяСсылка());
	Структура.Вставить("BYN", Справочники.Валюты.ПустаяСсылка());
	Структура.Вставить("ПутьДляВыгрузки", "");
	Структура.Вставить("ПутьДляВыгрузкиИнвойсов", "");
	Структура.Вставить("ПутьДляКопийФактур", "");
	Структура.Вставить("ПутьВыгрузкиДляСайта", "");
	Структура.Вставить("APIСайтДляВыгрузкиДанных", "");
	Структура.Вставить("APIРесурсВыгрузкиКлиентов", "");
	Структура.Вставить("APIРесурсВыгрузкиОплат", "");
	Структура.Вставить("APIРесурсВыгрузкиФактуры", "");
	Структура.Вставить("APIРесурсВыгрузкиБаланса", "");
	Структура.Вставить("APIРесурсУдалениеДанных", "");
	Структура.Вставить("APIРесурсУдалениеКарточек", "");
	Структура.Вставить("APIРесурсВыгрузкиТранзакций", "");
	Структура.Вставить("APIРесурсВыгрузкиПаролей", "");
	Структура.Вставить("APIKey", "");
	Структура.Вставить("ПарольАрхиваПриОбмене", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Настройки.EUR КАК EUR,
	|	Настройки.USD КАК USD,
	|	Настройки.RUB КАК RUB,
	|	Настройки.BYN КАК BYN,
	|	Настройки.ПутьДляВыгрузки КАК ПутьДляВыгрузки,
	|	Настройки.ПутьДляВыгрузкиИнвойсов КАК ПутьДляВыгрузкиИнвойсов,
	|	Настройки.ПутьДляКопийФактур КАК ПутьДляКопийФактур,
	|	Настройки.ПутьВыгрузкиДляСайта КАК ПутьВыгрузкиДляСайта,
	|	Настройки.APIСайтДляВыгрузкиДанных КАК APIСайтДляВыгрузкиДанных,
	|	Настройки.APIРесурсВыгрузкиКлиентов КАК APIРесурсВыгрузкиКлиентов,
	|	Настройки.APIРесурсВыгрузкиОплат КАК APIРесурсВыгрузкиОплат,
	|	Настройки.APIРесурсВыгрузкиФактуры КАК APIРесурсВыгрузкиФактуры,
	|	Настройки.APIРесурсВыгрузкиБаланса КАК APIРесурсВыгрузкиБаланса,
	|	Настройки.APIРесурсУдалениеДанных КАК APIРесурсУдалениеДанных,
	|	Настройки.APIРесурсУдалениеКарточек КАК APIРесурсУдалениеКарточек,
	|	Настройки.APIKey КАК APIKey,
	|	Настройки.APIРесурсВыгрузкиТранзакций КАК APIРесурсВыгрузкиТранзакций,
	|	Настройки.ПарольАрхиваПриОбмене КАК ПарольАрхиваПриОбмене,
	|	Настройки.APIРесурсВыгрузкиПаролей КАК APIРесурсВыгрузкиПаролей
	|ИЗ
	|	Справочник.Настройки КАК Настройки
	|ГДЕ
	|	Настройки.Ссылка = ЗНАЧЕНИЕ(Справочник.Настройки.ПредопределенныеНастройки)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Структура, Выборка);
	КонецЕсли;
	
	Возврат Структура;
КонецФункции

#КонецОбласти

#КонецЕсли