// Таблица печати шаблон.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица печати шаблон:
// * Выбран - Булево - 
// * Контрагент - СправочникСсылка.Контрагенты - 
// * НомерФактуры - Число - 
// * ЭтапОплаты - Число - 
Функция ТаблицаПечатиШаблон()
	ТаблицаПечати = Новый ТаблицаЗначений();
	ТаблицаПечати.Колонки.Добавить("Выбран", Новый ОписаниеТипов("Булево"));
	ТаблицаПечати.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаПечати.Колонки.Добавить("НомерФактуры", Новый ОписаниеТипов("Число"));
	ТаблицаПечати.Колонки.Добавить("ЭтапОплаты", Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаПечати;
КонецФункции

