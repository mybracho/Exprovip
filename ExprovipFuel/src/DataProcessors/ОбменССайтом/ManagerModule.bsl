// Передать данные на сайт.
// 
// Параметры:
//  ДанныеJSON - Строка - Данные JSON
//  СтруктураAPI - Структура - Структура API:
// * АдресAPI - Строка - 
// * РесурсAPI - Строка - 
// 
// Возвращаемое значение:
//  Структура - Передать данные на сайт:
// * Результат - Булево - 
// * МассивОшибок - Массив из Строка 
// * Комментарий - Строка - 
Функция ПередатьДанныеНаСайт(ДанныеJSON, СтруктураAPI)
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Результат", Истина);
	СтруктураОтвета.Вставить("МассивОшибок", Новый Массив);
	СтруктураОтвета.Вставить("Комментарий", "");
	
	АдресАпи = СтруктураAPI.АдресAPI;
	АдресРесурса = СтруктураAPI.РесурсAPI;
	
	Настройки = Справочники.Настройки.ПолучитьНастройки();
	
	ТелоЗапроса = ДанныеJSON;
	
	Попытка	
		Соединение = Новый HTTPСоединение(АдресАпи, , , , , , Истина);
		Запрос = Новый HTTPЗапрос(АдресРесурса);
		Запрос.Заголовки.Вставить("X-Webhook-Key", СокрЛП(Настройки.APIKey));
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния <> 200 Тогда
			СтруктураОтвета.Результат = Ложь;
			Попытка
				ОтветСоответствие = Exprovip.ДесериалозоватьJSON(ТелоОтвета, Истина); //Соответствие
				ИтоговыйРезультат = ОтветСоответствие.Получить("message");
				СтруктураОтвета.МассивОшибок.Добавить(ИтоговыйРезультат);
				СоответствиеОшибок = ОтветСоответствие.Получить("errors"); //Соответствие
				Для Каждого КлючИЗначение Из СоответствиеОшибок Цикл
					ТекущееСообщение = Новый Массив;
					ТекущееСообщение.Добавить(КлючИЗначение.Ключ);
					Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
						Для Каждого СообщениеВМассиве Из КлючИЗначение.Значение Цикл
							ТекущееСообщение.Добавить(СообщениеВМассиве);
						КонецЦикла;	
					КонецЕсли;
					СтруктураОтвета.МассивОшибок.Добавить(СтрСоединить(ТекущееСообщение, Символы.ПС));
				КонецЦикла;	
			Исключение	
				СтруктураОтвета.МассивОшибок.Добавить(СтрШаблон("Код ответа: %1. Ответ: %2", Ответ.КодСостояния, ТелоОтвета));
			КонецПопытки;
		Иначе
			ОтветСтруктура = Exprovip.ДесериалозоватьJSON(ТелоОтвета, Истина); //Соответствие
			СтруктураОтвета.Результат = ОтветСтруктура.Получить("success");
			СтруктураОтвета.Комментарий = ОтветСтруктура.Получить("message");
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Ответ сайта: %1", СтруктураОтвета.Комментарий));	
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		СтруктураОтвета.Результат = Ложь;
		СтруктураОтвета.МассивОшибок.Добавить(Ошибка);
	КонецПопытки;
	
	Возврат СтруктураОтвета;	
КонецФункции		

