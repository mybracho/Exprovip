// Выполняет сверку данных документа с шаблоном фактуры и показывает результаты сверки пользователю
//
// Параметры:
//   Команда - КомандаФормы
&НаКлиенте
Процедура СверкаДанныхСШаблонФактурой(Команда)
	Проверка = ПолучитьТабличныйДокументСверкиСШаблонамиФактур();
	Если Проверка.Результат Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Данные в фактурах и шаблон-фактурах равны'"));
		Возврат;
	КонецЕсли;	
	
	ТабличныйДокументСверки = Проверка.ТабличныйДокумент;
	ТабличныйДокументСверки.Показать("Сверка с шаблоном фактуры");
КонецПроцедуры
#КонецОбласти

