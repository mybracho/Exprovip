// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// Получить структуру печати.
// 
// Возвращаемое значение:
//  Структура - См. Документы.Фактура.ПолучитьСтруктуруПечати
&НаСервере
Функция ПолучитьСтруктуруПечати()	
	Возврат Документы.Фактура.ПолучитьСтруктуруПечати(РеквизитФормыВЗначение("Объект"));
КонецФункции

// Формирует табличный документ с расхождениями между транзакциями текущей фактуры и
//  транзакциями в документах-основаниях
// (шаблонах фактур).
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Булево - признак отсутствия расхождений. Истина - расхождений нет, Ложь - есть расхождения
//     * ТабличныйДокумент - ТабличныйДокумент - сформированный документ с данными о расхождениях
&НаСервере
Функция ПолучитьТабличныйДокументСверкиСШаблонамиФактур()
	Структура = Новый Структура;
	Структура.Вставить("Результат", Истина);
	Структура.Вставить("ТабличныйДокумент", Новый ТабличныйДокумент);
	
	ТаблицаТранзакций = Объект.Транзакции.Выгрузить();
	
	МассивОснований = ТаблицаТранзакций.ВыгрузитьКолонку("ДокументОснование");
	
	Если МассивОснований.Количество() = 0 Тогда
		Сообщение = НСтр("ru = 'Транзакции не имеют документов-оснований. Сверка невозможна.'");
		ВызватьИсключение(Сообщение);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаТранзакций", ТаблицаТранзакций);
	Запрос.УстановитьПараметр("МассивСсылок", МассивОснований);
	#Область ТекстЗапроса
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ФактураШаблонТранзакции.ДатаТранзакции КАК ДатаТранзакции,
	|	ФактураШаблонТранзакции.Карта КАК Карта,
	|	ФактураШаблонТранзакции.Клиент КАК Клиент,
	|	ФактураШаблонТранзакции.Автомобиль КАК Автомобиль,
	|	ФактураШаблонТранзакции.МестоТранзакции КАК МестоТранзакции,
	|	ФактураШаблонТранзакции.Продукт КАК Продукт,
	|	ФактураШаблонТранзакции.Цена КАК Цена,
	|	СУММА(ФактураШаблонТранзакции.Количество) КАК Количество,
	|	ФактураШаблонТранзакции.Ссылка КАК ШаблонФактура
	|ПОМЕСТИТЬ ВТ_ДанныеШаблоновФактур
	|ИЗ
	|	Документ.ФактураШаблон.Транзакции КАК ФактураШаблонТранзакции
	|ГДЕ
	|	ФактураШаблонТранзакции.Ссылка В (&МассивСсылок)
	|СГРУППИРОВАТЬ ПО
	|	ФактураШаблонТранзакции.Автомобиль,
	|	ФактураШаблонТранзакции.ДатаТранзакции,
	|	ФактураШаблонТранзакции.Карта,
	|	ФактураШаблонТранзакции.Клиент,
	|	ФактураШаблонТранзакции.МестоТранзакции,
	|	ФактураШаблонТранзакции.Продукт,
	|	ФактураШаблонТранзакции.Ссылка,
	|	ФактураШаблонТранзакции.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТранзакций.ДатаТранзакции КАК ДатаТранзакции,
	|	ТаблицаТранзакций.Карта КАК Карта,
	|	ТаблицаТранзакций.Клиент КАК Клиент,
	|	ТаблицаТранзакций.Автомобиль КАК Автомобиль,
	|	ТаблицаТранзакций.МестоТранзакции КАК МестоТранзакции,
	|	ТаблицаТранзакций.Продукт КАК Продукт,
	|	ТаблицаТранзакций.Цена КАК Цена,
	|	ТаблицаТранзакций.Количество КАК Количество,
	|	ТаблицаТранзакций.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ВТ_ТаблицаТранзакцийФактуры
	|ИЗ
	|	&ТаблицаТранзакций КАК ТаблицаТранзакций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТранзакцийФактуры.ДатаТранзакции КАК ДатаТранзакции,
	|	ВТ_ТаблицаТранзакцийФактуры.Карта КАК Карта,
	|	ВТ_ТаблицаТранзакцийФактуры.Клиент КАК Клиент,
	|	ВТ_ТаблицаТранзакцийФактуры.Автомобиль КАК Автомобиль,
	|	ВТ_ТаблицаТранзакцийФактуры.МестоТранзакции КАК МестоТранзакции,
	|	ВТ_ТаблицаТранзакцийФактуры.Продукт КАК Продукт,
	|	ВТ_ТаблицаТранзакцийФактуры.Цена КАК Цена,
	|	СУММА(ВТ_ТаблицаТранзакцийФактуры.Количество) КАК Количество,
	|	ВТ_ТаблицаТранзакцийФактуры.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ВТ_ТаблицаТранзакцийФактурыСвертка
	|ИЗ
	|	ВТ_ТаблицаТранзакцийФактуры КАК ВТ_ТаблицаТранзакцийФактуры
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаТранзакцийФактуры.Автомобиль,
	|	ВТ_ТаблицаТранзакцийФактуры.ДатаТранзакции,
	|	ВТ_ТаблицаТранзакцийФактуры.ДокументОснование,
	|	ВТ_ТаблицаТранзакцийФактуры.Карта,
	|	ВТ_ТаблицаТранзакцийФактуры.Клиент,
	|	ВТ_ТаблицаТранзакцийФактуры.МестоТранзакции,
	|	ВТ_ТаблицаТранзакцийФактуры.Продукт,
	|	ВТ_ТаблицаТранзакцийФактуры.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеШаблоновФактур.ШаблонФактура КАК ШаблонФактура,
	|	ВТ_ДанныеШаблоновФактур.ДатаТранзакции КАК ДатаТранзакции,
	|	ВТ_ДанныеШаблоновФактур.Карта КАК Карта,
	|	ВТ_ДанныеШаблоновФактур.Клиент КАК Клиент,
	|	ВТ_ДанныеШаблоновФактур.Автомобиль КАК Автомобиль,
	|	ВТ_ДанныеШаблоновФактур.МестоТранзакции КАК МестоТранзакции,
	|	ВТ_ДанныеШаблоновФактур.Продукт КАК Продукт,
	|	ВТ_ДанныеШаблоновФактур.Количество КАК КоличествоШаблонФактура,
	|	0 КАК КоличествоФактура
	|ПОМЕСТИТЬ ВТ_ОбъединениеДанных
	|ИЗ
	|	ВТ_ДанныеШаблоновФактур КАК ВТ_ДанныеШаблоновФактур
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.ДокументОснование,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.ДатаТранзакции,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.Карта,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.Клиент,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.Автомобиль,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.МестоТранзакции,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.Продукт,
	|	0,
	|	ВТ_ТаблицаТранзакцийФактурыСвертка.Количество
	|ИЗ
	|	ВТ_ТаблицаТранзакцийФактурыСвертка КАК ВТ_ТаблицаТранзакцийФактурыСвертка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОбъединениеДанных.ШаблонФактура КАК ШаблонФактура,
	|	ВТ_ОбъединениеДанных.ДатаТранзакции КАК ДатаТранзакции,
	|	ВТ_ОбъединениеДанных.Карта КАК Карта,
	|	ВТ_ОбъединениеДанных.Клиент КАК Клиент,
	|	ВТ_ОбъединениеДанных.Автомобиль КАК Автомобиль,
	|	ВТ_ОбъединениеДанных.МестоТранзакции КАК МестоТранзакции,
	|	ВТ_ОбъединениеДанных.Продукт КАК Продукт,
	|	СУММА(ВТ_ОбъединениеДанных.КоличествоШаблонФактура) КАК КоличествоШаблонФактура,
	|	СУММА(ВТ_ОбъединениеДанных.КоличествоФактура) КАК КоличествоФактура
	|ПОМЕСТИТЬ ВТ_ГруппировкаОбъединенныхДанных
	|ИЗ
	|	ВТ_ОбъединениеДанных КАК ВТ_ОбъединениеДанных
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОбъединениеДанных.Автомобиль,
	|	ВТ_ОбъединениеДанных.ДатаТранзакции,
	|	ВТ_ОбъединениеДанных.Карта,
	|	ВТ_ОбъединениеДанных.Клиент,
	|	ВТ_ОбъединениеДанных.МестоТранзакции,
	|	ВТ_ОбъединениеДанных.Продукт,
	|	ВТ_ОбъединениеДанных.ШаблонФактура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ГруппировкаОбъединенныхДанных.ШаблонФактура КАК ШаблонФактура,
	|	ВТ_ГруппировкаОбъединенныхДанных.ДатаТранзакции КАК ДатаТранзакции,
	|	ВТ_ГруппировкаОбъединенныхДанных.Карта КАК Карта,
	|	ВТ_ГруппировкаОбъединенныхДанных.Клиент КАК Клиент,
	|	ВТ_ГруппировкаОбъединенныхДанных.Автомобиль КАК Автомобиль,
	|	ВТ_ГруппировкаОбъединенныхДанных.МестоТранзакции КАК МестоТранзакции,
	|	ВТ_ГруппировкаОбъединенныхДанных.Продукт КАК Продукт,
	|	ВТ_ГруппировкаОбъединенныхДанных.КоличествоШаблонФактура КАК КоличествоШаблонФактура,
	|	ВТ_ГруппировкаОбъединенныхДанных.КоличествоФактура КАК КоличествоФактура
	|ИЗ
	|	ВТ_ГруппировкаОбъединенныхДанных КАК ВТ_ГруппировкаОбъединенныхДанных
	|ГДЕ
	|	ВТ_ГруппировкаОбъединенныхДанных.КоличествоФактура <> ВТ_ГруппировкаОбъединенныхДанных.КоличествоШаблонФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШаблонФактура,
	|	Клиент,
	|	Карта,
	|	ДатаТранзакции";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Макет = Документы.Фактура.ПолучитьМакет("РасхожденияШаблонаФактурыИФактуры");

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапка.Параметры.ПредставлениеФактуры = Объект.Ссылка;
	ТабличныйДокумент.Вывести(ОбластьШапка);

	Пока Выборка.Следующий() Цикл
		Структура.Результат = Ложь;
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	ТабличныйДокумент.ФиксацияСверху = 3;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;

	Структура.ТабличныйДокумент = ТабличныйДокумент;
	Возврат Структура;

КонецФункции	

&НаСервере
Процедура ВывестиИтогиПоДокументуНаСервере()
	ТабличныйДокументИтоги.Очистить();
	
	ТаблицаИтогов = Объект.Транзакции.Выгрузить(, "ВалютаПоставщика, Количество");
	ТаблицаИтогов.Свернуть("ВалютаПоставщика", "Количество");
	
	Макет = Документы.Фактура.ПолучитьМакет("ИтогиПоДокументу");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.ЗаголовокВалюта = "Валюта поставщика";
	ТабличныйДокументИтоги.Вывести(ОбластьШапка);
	Для Каждого СтрокаТаблицы Из ТаблицаИтогов Цикл
		ОбластьСтрока.Параметры.Валюта = СтрокаТаблицы.ВалютаПоставщика;
		ОбластьСтрока.Параметры.Количество = СтрокаТаблицы.Количество;
		
		ТабличныйДокументИтоги.Вывести(ОбластьСтрока);	
	КонецЦикла;	
	ОбластьИтог.Параметры.Количество = ТаблицаИтогов.Итог("Количество");
	ТабличныйДокументИтоги.Вывести(ОбластьИтог);
	
КонецПроцедуры

&НаСервере
Процедура БлокировкаЭлементов()
	Если Не Объект.Проведен Тогда
		//Блокируем только проведенные
		Возврат;
	КонецЕсли;
	МассивТиповИсключений = Новый Массив;
	МассивТиповИсключений.Добавить(Тип("ДекорацияФормы"));
	МассивТиповИсключений.Добавить(Тип("ДополнениеЭлементаФормы"));
	
	МассивТиповДоступность = Новый Массив;
	МассивТиповДоступность.Добавить(Тип("КнопкаФормы"));
	
	МассивЭлементовИсключений = Новый Массив;
	МассивЭлементовИсключений.Добавить(Элементы.ТранзакцииВыгрузитьНаСайт);
	МассивЭлементовИсключений.Добавить(Элементы.ТранзакцииПечать);
	МассивЭлементовИсключений.Добавить(Элементы.ТранзакцииСверкаДанныхСШаблонФактурой);
		
	Для Каждого ЭлементФормы Из Элементы Цикл
		ИмяЭлемента = ЭлементФормы.Имя;
		
		Если МассивЭлементовИсключений.Найти(ЭлементФормы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипЭлемента = ТипЗнч(ЭлементФормы);
		
		Если МассивТиповИсключений.Найти(ТипЭлемента) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ИмяЭлемента, "ИТК_") > 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если МассивТиповДоступность.Найти(ТипЭлемента) <> Неопределено Тогда
			ЭлементФормы.Доступность = Ложь;
			Продолжить;
		КонецЕсли;
		ЭлементФормы.ТолькоПросмотр = Истина;
	КонецЦикла;
КонецПроцедуры	

#КонецОбласти

